{
	"name": "pi-extensions",
	"version": "0.1.0",
	"description": "Custom pi coding agent packages, including web access, subagents, planning, memory, goals, and the Pi Web Control Deck.",
	"type": "module",
	"keywords": [
		"pi-package"
	],
	"pi": {
		"extensions": [
			"./packages/env/extensions",
			"./packages/web-access/extensions",
			"./packages/subagents/extensions",
			"./packages/todo/extensions",
			"./packages/plan/extensions",
			"./packages/failover/extensions",
			"./packages/memory/extensions",
			"./packages/loop/extensions",
			"./packages/pi-web/extensions"
		]
	},
	"peerDependencies": {
		"@earendil-works/pi-agent-core": "*",
		"@earendil-works/pi-coding-agent": "*",
		"@earendil-works/pi-ai": "*",
		"typebox": "*"
	},
	"scripts": {
		"test": "node --test \"tests/*.test.mjs\"",
		"evals:list": "ls evals 2>/dev/null || echo '(no evals yet)'"
	}
}
