{
  "name": "pi-web",
  "version": "0.1.0",
  "description": "Local Control Deck for pi sessions, skills, extensions, packages, and memory.",
  "type": "module",
  "keywords": [
    "pi-package"
  ],
  "files": [
    "extensions",
    "lib",
    "server",
    "public",
    "package.json"
  ],
  "pi": {
    "extensions": [
      "./extensions"
    ]
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "build:smoke": "vite build --outDir .vite-smoke --emptyOutDir",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "verify:public": "node ./scripts/verify-public.mjs"
  },
  "dependencies": {
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-markdown": "10.1.0",
    "react-router-dom": "7.18.3",
    "remark-gfm": "4.0.1",
    "valtio": "1.13.2"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.2.2",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.0",
    "@testing-library/user-event": "14.6.1",
    "@types/node": "24.10.1",
    "@types/react": "18.3.27",
    "@types/react-dom": "18.3.7",
    "@vitejs/plugin-react": "5.1.1",
    "jsdom": "27.2.0",
    "less": "4.9.1",
    "postcss": "8.5.28",
    "tailwindcss": "4.2.2",
    "typescript": "~5.9.3",
    "vite": "7.3.6",
    "vitest": "4.1.11"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*"
  }
}
